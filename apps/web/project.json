{
  "name": "web",
  "root": "apps/web",
  "implicitDependencies": [
    "ui",
    "auth"
  ],
  "targets": {
    "serve": {
      "command": "pnpm --dir apps/web serve",
      "continuous": true
    },
    "build": {
      "command": "pnpm --dir apps/web build",
      "inputs": ["default", "^default", "sharedGlobals"],
      "outputs": [
        "{projectRoot}/.next"
      ]
    }
  }
}
