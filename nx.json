{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/bin/**/*",
      "!{projectRoot}/obj/**/*",
      "!{projectRoot}/.next/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/src-tauri/target/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.json"
    ],
    "backendGlobals": [
      "{workspaceRoot}/Directory.Build.props",
      "{workspaceRoot}/global.json",
      "{workspaceRoot}/Vodown.slnx"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "sharedGlobals"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "sharedGlobals"
      ]
    }
  },
  "analytics": true
}