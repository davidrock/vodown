{
  "manifest_version": 3,
  "name": "Vodown — Whop, Hotmart e Kiwify",
  "version": "1.6.0",
  "description": "Baixe aulas acessíveis pela sua conta em MP4. Processamento inteiramente no Chrome, sem aplicativo externo.",
  "minimum_chrome_version": "116",
  "icons": {"16":"assets/icon-16.png","32":"assets/icon-32.png","48":"assets/icon-48.png","128":"assets/icon-128.png"},
  "permissions": ["activeTab", "scripting", "webNavigation", "storage", "sidePanel", "downloads", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://whop.com/*", "https://*.whop.com/*", "https://hotmart.com/*", "https://*.play.hotmart.com/*", "https://contentplayer.hotmart.com/*", "https://*.mux.com/*", "https://members.kiwify.com/*", "https://d3pjuhbfoxhm7c.cloudfront.net/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Abrir Vodown", "default_icon":{"16":"assets/icon-16.png","32":"assets/icon-32.png","48":"assets/icon-48.png"}},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"}
}
